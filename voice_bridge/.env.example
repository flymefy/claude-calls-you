# انسخ هذا الملف إلى .env واملأ القيم (لا ترفع .env إلى git ولا تلصقه في أي محادثة عامة)

TWILIO_ACCOUNT_SID=
# الخيار الأبسط للحساب التجريبي: Auth Token
TWILIO_AUTH_TOKEN=
# أو (أفضل أمنياً) مفتاح API بدل Auth Token:
TWILIO_API_KEY=
TWILIO_API_SECRET=

# رقم Twilio الذي يتصل منك (بصيغة E.164 مثل +1555...)
TWILIO_FROM_NUMBER=
# رقم هاتفك الموثّق في حساب Twilio (بصيغة E.164 مثل +20...)
MY_PHONE_NUMBER=

# ---- اختياري ----

# حماية الرصيد
MAX_CALLS_PER_HOUR=6
HOOK_COOLDOWN_SEC=600
MAX_MESSAGE_CHARS=350
RING_TIMEOUT_SEC=30

# لإيقاف مكالمات الهوكس مؤقتاً: VOICE_HOOKS=off
VOICE_HOOKS=on

# بديل عن cloudflared إذا كان لديك نطاق ثابت (ngrok/خادم خاص): ضع الرابط والمنفذ المحلي
PUBLIC_BASE_URL=
LOCAL_PORT=0
CLOUDFLARED_PATH=

# فرض رفض الطلبات ذات التوقيع الخاطئ (الافتراضي: تحذير فقط)
ENFORCE_SIGNATURE=0

# ---- وضع ElevenLabs (وكيل صوتي يتحدث معك بالعربية؛ يستخدم رقم Twilio نفسه) ----
# الوضع: twilio (رسالة صوتية + ضغط أرقام) أو elevenlabs (حوار صوتي)
NOTIFY_MODE=agent  # agent = عمر يتحدث معك صوتياً عبر Twilio | twilio = رسالة وضغط أرقام
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# يُملأ تلقائياً بعد: python voice_bridge/selftest.py eleven-setup
ELEVENLABS_PHONE_NUMBER_ID=
# محرك الصوت داخل مكالمة Twilio: piper (محلي) أو elevenlabs (جودة أعلى، يستهلك الحصة المجانية)
TTS_ENGINE=piper
ELEVENLABS_VOICE_ID=xvhpbk8otnNHtT3fjCpr
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# speech = تتكلم بالرد (Twilio يحوّل صوتك نصاً) | digits = ضغط أرقام
VOICE_REPLY=speech
TWILIO_SPEECH_LANG=ar-SA
